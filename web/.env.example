# Copy to web/.env (never commit .env).

# --- Supabase (optional) ---------------------------------------------------
# Leave these empty to run in DEMO MODE: data lives in your browser's storage.
# Fill them in (Supabase -> Project Settings -> API) for real accounts and cloud storage.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Force demo mode even when Supabase is configured
VITE_DEMO_MODE=false

# --- AI server (optional) --------------------------------------------------
# The Flask server in /api. It holds the AI provider key (Groq); the browser never sees it.
# "/api" goes through the dev server proxy (vite.config.ts). When deployed, use the API's full URL.
# Leave empty to use the clearly labelled offline demo answers instead.
VITE_API_URL=/api
