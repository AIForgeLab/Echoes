# Copy to api/.env (never commit .env).
# Chat model: any OpenAI-compatible provider. Default: Groq (free key at https://console.groq.com)
GROQ_API_KEY=gsk_your-key-here
CHAT_BASE_URL=https://api.groq.com/openai/v1
CHAT_MODEL=openai/gpt-oss-120b
# For "thinking" models such as gpt-oss: low | medium | high (low is fastest)
CHAT_REASONING_EFFORT=low

# Optional embedding API for Pentimento. Leave empty to use the built-in local similarity.
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_MODEL=

# Fill these ONLY when the web app uses Supabase (live mode). The API then rejects
# requests from people who aren't signed in. Leave them empty for demo mode.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Where the web app runs (CORS). Comma-separate several origins.
WEB_ORIGIN=http://localhost:5173
